# This repository is a workspace shell. Track only the files explicitly
# re-included below; every project and runtime artifact belongs elsewhere.
*
!.gitignore
!README.md
!AGENTS.md
!pyproject.toml
!src/
src/*
!src/quantresearch_acceptance/
src/quantresearch_acceptance/*
!src/quantresearch_acceptance/*.py

# Independent Manager GUI owner package.
!manager-gui/
!manager-gui/README.md
!manager-gui/pyproject.toml
!manager-gui/src/
!manager-gui/src/manager_gui/
!manager-gui/src/manager_gui/*.py
!manager-gui/src/manager_gui/reader/
!manager-gui/src/manager_gui/reader/*.py
!manager-gui/src/manager_gui/web/
!manager-gui/src/manager_gui/web/*.py
!manager-gui/src/manager_gui/web/i18n/
!manager-gui/src/manager_gui/web/i18n/*.py
!manager-gui/src/manager_gui/web/i18n/catalog/
!manager-gui/src/manager_gui/web/i18n/catalog/*.py

# Local-only by default. AGENTS.md defines the narrow exceptions.
/runtime/
/tests/
/tools/
/artifacts/
/dist/
/docs/
